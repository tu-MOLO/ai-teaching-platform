# ============================================
# EditorConfig: 跨编辑器编码风格一致性配置
# ============================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,scss,less,html,md,yaml,yml}]
indent_size = 2

[*.bat]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[{*.md,*.txt}]
trim_trailing_whitespace = false