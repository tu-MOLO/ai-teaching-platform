# ============================================
# Docker Compose 环境配置示例
# 复制此文件为 .env 并修改所有密码和密钥
# 警告: 生产环境必须使用强随机密钥！
# ============================================

# 数据库配置
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=ai_teaching
DB_PORT=5432

# MinIO 配置
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=ai-teaching
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis 配置
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 后端配置
BACKEND_PORT=8000
# 生产环境必须使用至少32字符的强随机密钥
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Nginx 配置（可选）
NGINX_PORT=80
NGINX_HTTPS_PORT=443