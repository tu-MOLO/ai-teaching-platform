# ============================================
# AI教学平台后端环境配置示例
# 复制此文件为.env并修改配置值
# ============================================

# 应用配置
APP_NAME="AI Teaching Platform"
APP_VERSION="1.0.0"
DEBUG=true

# API配置
API_V1_STR=/api/v1

# CORS配置（多个来源用逗号分隔）
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 数据库配置
# 本地交付默认使用 SQLite；如需切换数据库再覆盖本项
DATABASE_URL=sqlite+aiosqlite:///./ai_teaching.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT配置
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=ai-teaching
MINIO_SECURE=false
MINIO_REGION=us-east-1

# 文件上传配置
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.md,.jpg,.jpeg,.png,.gif,.mp4,.mp3

# Redis配置（可选）
# REDIS_URL=redis://localhost:6379/0

# 日志配置
LOG_LEVEL=INFO

# AI助手配置
BIGMODEL_API_KEY=
BIGMODEL_API_BASE=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-4.7-flash
AI_MAX_CONTEXT_MESSAGES=20
