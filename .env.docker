# ============================================
# Docker Compose 环境配置
# 复制此文件为 .env 并根据需要修改
# ============================================

# 数据库配置
DB_USER=postgres
DB_PASSWORD=your-strong-db-password-here
DB_NAME=ai_teaching
DB_PORT=5432

# MinIO 配置
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-strong-minio-password-here
MINIO_BUCKET_NAME=ai-teaching
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis 配置
REDIS_PORT=6379

# 后端配置
BACKEND_PORT=8000
SECRET_KEY=your-very-strong-secret-key-here-minimum-32-characters-long
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Nginx 配置（可选）
NGINX_PORT=80
NGINX_HTTPS_PORT=443
